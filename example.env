# Database configuration
# You can use either DATABASE_URL or individual variables

# Option 1: Full connection string
# DATABASE_URL=postgres://user:password@localhost/dbname?sslmode=disable

# Option 2: Individual variables
DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=dbname
DB_SSLMODE=disable

# Telegram configuration (optional)
# Get bot token from @BotFather on Telegram
# Get chat ID from @userinfobot or create a channel/group and add the bot
# For topics in groups: get message_thread_id from the topic URL or use @getidsbot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_TOPIC_ID=your_topic_id_here